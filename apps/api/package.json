    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:deploy": "prisma migrate deploy",
    "db:backup": "node scripts/backup/backup.mjs",
    "db:restore": "node scripts/backup/restore.mjs",
    "bench:file": "node test/load/generate-file.mjs",
    "bench:import": "node test/load/import-export-bench.mjs",
    "bench:load": "node test/load/load-test.mjs",
    "start:cluster": "node dist/cluster.js"
  },
