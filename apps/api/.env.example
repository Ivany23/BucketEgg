# Copie para .env e preencha. NUNCA faça commit do .env real.

# ── Base de dados (Neon) ─────────────────────────────────────────────────────
# Ligação COM pooling (endereço "-pooler"): tráfego normal da API.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Ligação DIRETA (sem "-pooler"): migrações e importações em massa (COPY), como a Neon recomenda.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGIAO.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Base de TESTES (pnpm test:e2e APAGA tudo nela). O nome da base TEM de terminar em "_test".
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb_test?sslmode=require"
TEST_DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGIAO.aws.neon.tech/neondb_test?sslmode=require"

# Backup incremental diário (pnpm db:backup). Destino: de preferência OUTRO projeto Neon noutra região.
# Restauro numa base vazia já migrada: pnpm db:restore -- "postgresql://..."
BACKUP_DATABASE_URL="postgresql://USER:PASSWORD@ep-yyyy.OUTRA-REGIAO.aws.neon.tech/neondb_backup?sslmode=require"

# ── Segurança ────────────────────────────────────────────────────────────────
# Obrigatório em produção (mín. 32 caracteres). Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="1d"
# Origens autorizadas (frontend), separadas por vírgula. Ex.: https://bucketegg.vercel.app
# Um * vale para um segmento do domínio (pré-visualizações do Vercel): https://bucketegg-*.vercel.app
CORS_ORIGINS="http://localhost:3001"
# Nº de proxies à frente da API (balanceador). Por defeito 1 em produção, false em desenvolvimento.
# TRUST_PROXY="1"
# Pedidos por minuto por utilizador autenticado (login/registo têm limite próprio de 10/min)
# THROTTLE_PER_MINUTE=600

PORT=3000

# ── Desempenho ───────────────────────────────────────────────────────────────
# Ligações à base de dados POR PROCESSO. Regra: processos x (DB_POOL_SIZE + IMPORT_CONCURRENCY + 1)
# tem de caber no limite da base de dados (Neon direto: 104 ligações em 0,25 CU; pelo -pooler: 10 000).
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=10
# Transações (ms): espera por uma ligação livre e duração máxima de cada transação.
# DB_TX_MAX_WAIT_MS=10000
# DB_TX_TIMEOUT_MS=15000
# Só para 'pnpm start:cluster' (servidor/VM): nº de processos. Por omissão, um por núcleo.
# Em contentores (Railway, Render, Cloud Run...) use 'node dist/main.js' e várias réplicas.
# WEB_CONCURRENCY=4

# ── Ficheiros e importações ──────────────────────────────────────────────────
# local = disco do servidor (desenvolvimento ou UMA instância). s3 = AWS S3 / Cloudflare R2 (produção).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# Com STORAGE_DRIVER=s3 (exemplo Cloudflare R2):
# S3_BUCKET="bucketegg-imports"
# S3_REGION="auto"
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"

UPLOAD_MAX_MB=500          # tamanho máximo por ficheiro
IMPORT_MAX_ROWS=5000000    # linhas máximas por importação
IMPORT_CONCURRENCY=2       # importações em paralelo por instância
# IMPORT_WORKER_ENABLED=true  # false numa instância que só deve servir pedidos HTTP
# AUTH_CACHE_TTL_MS=10000     # cache do estado de acesso (revogação demora no máx. isto noutras instâncias)

# Opcional: otimização de rotas pela Google ROUTES API (ativar "Routes API" na Google Cloud; a Directions API
# antiga é "legado" e é recusada em projetos novos). Sem chave, ou se a Google falhar, usa o otimizador local.
GOOGLE_MAPS_API_KEY=""
