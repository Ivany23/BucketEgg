# Copie para .env.local. Variáveis NEXT_PUBLIC_* vão para o browser: nunca coloque segredos aqui.

# Endereço da API BucketEgg (NestJS). Em produção: o domínio da API em Frankfurt.
NEXT_PUBLIC_API_URL=http://localhost:3000

# 1 = mostra as contas de demonstração no ecrã "Entrar" e o "Simular GPS" no terreno.
# Deixe vazio em produção.
NEXT_PUBLIC_DEMO_LOGIN=

# Mosaicos do mapa (opcional). Por omissão: OpenStreetMap oficial (uso interativo, com atribuição).
# Com muito tráfego, use um fornecedor com chave, ex.:
# NEXT_PUBLIC_MAP_TILES=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=SUA_CHAVE
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
